<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <UserSecretsId>SignalTracker.LocalDevelopment</UserSecretsId>
    <DefaultItemExcludes>$(DefaultItemExcludes);buildcheck_*\**;**\buildcheck_*\**;build_*\**;**\build_*\**;tmpout_*\**;**\tmpout_*\**;build_obj\**;**\build_obj\**;build_out\**;**\build_out\**;artifacts\**;**\artifacts\**;bin_temp\**;**\bin_temp\**;bin_temp_check\**;**\bin_temp_check\**;_build_check\**;_build_check3\**;_codex_tmp_index\**;Tools\CiProbe\**</DefaultItemExcludes>
    <DefaultExcludesInProjectFolder>$(DefaultExcludesInProjectFolder);buildcheck_*\**;**\buildcheck_*\**;build_*\**;**\build_*\**;tmpout_*\**;**\tmpout_*\**;build_obj\**;**\build_obj\**;build_out\**;**\build_out\**;artifacts\**;**\artifacts\**;bin_temp\**;**\bin_temp\**;bin_temp_check\**;**\bin_temp_check\**;_build_check\**;_build_check3\**;_codex_tmp_index\**;Tools\CiProbe\**</DefaultExcludesInProjectFolder>
  </PropertyGroup>

  <!-- Remove old/unused files -->
  <ItemGroup>
    <Compile Remove="Controllers\NewFolder\**" />
    <Compile Remove="NewFolder\**" />
    <Compile Remove="CallAnalyzerRegression\**" />
    <Content Remove="Controllers\NewFolder\**" />
    <Content Remove="CallAnalyzerRegression\**" />
    <Content Remove="NewFolder\**" />
    <EmbeddedResource Remove="Controllers\NewFolder\**" />
    <EmbeddedResource Remove="NewFolder\**" />
    <None Remove="Controllers\NewFolder\**" />
    <None Remove="NewFolder\**" />
  </ItemGroup>

  <!-- Copy static templates to output & publish. Runtime uploads stay outside source control. -->
  <ItemGroup>
    <Content Include="Template-Files/**">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
  <Content Update="App_Data\**\*" CopyToPublishDirectory="Never" />
  <Content Update="UploadedExcels\**\*" CopyToPublishDirectory="Never" />
</ItemGroup>

  <!-- Packages (single group) -->
    <!-- Packages (single group) -->
