<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <DefaultItemExcludes>$(DefaultItemExcludes);buildcheck_*\**;**\buildcheck_*\**;build_*\**;**\build_*\**;tmpout_*\**;**\tmpout_*\**;build_obj\**;**\build_obj\**;build_out\**;**\build_out\**;artifacts\**;**\artifacts\**;bin_temp\**;**\bin_temp\**;bin_temp_check\**;**\bin_temp_check\**</DefaultItemExcludes>
    <DefaultExcludesInProjectFolder>$(DefaultExcludesInProjectFolder);buildcheck_*\**;**\buildcheck_*\**;build_*\**;**\build_*\**;tmpout_*\**;**\tmpout_*\**;build_obj\**;**\build_obj\**;build_out\**;**\build_out\**;artifacts\**;**\artifacts\**;bin_temp\**;**\bin_temp\**;bin_temp_check\**;**\bin_temp_check\**</DefaultExcludesInProjectFolder>
  </PropertyGroup>

  <!-- Remove old/unused files -->
  <ItemGroup>
    <Compile Remove="Controllers\NewFolder\**" />
    <Compile Remove="NewFolder\**" />
    <Content Remove="Controllers\NewFolder\**" />
    <Content Remove="NewFolder\**" />
    <EmbeddedResource Remove="Controllers\NewFolder\**" />
    <EmbeddedResource Remove="NewFolder\**" />
    <None Remove="Controllers\NewFolder\**" />
    <None Remove="NewFolder\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Controllers\ProcessExcelController - Copy %282%29.cs" />
    <Compile Remove="Controllers\ProcessExcelController - Copy.cs" />
    <Compile Remove="Models\CImage.aspx.cs" />
    <Compile Remove="Models\RandomImage.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Models\CImage.aspx" />
  </ItemGroup>

  <!-- Copy static files (templates/uploads) to output & publish -->
  <ItemGroup>
    <Content Include="Template-Files/**">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <Content Include="UploadedExcels/**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
  <Content Update="App_Data\**\*" CopyToPublishDirectory="PreserveNewest" />
  <Content Update="UploadedExcels\**\*" CopyToPublishDirectory="PreserveNewest" />
</ItemGroup>

